# -------------------------------------------------------------------
# Core Laravel
# -------------------------------------------------------------------
APP_NAME=lti-ox6q
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -------------------------------------------------------------------
# Database (SQLite, dev-friendly)
# -------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# -------------------------------------------------------------------
# CORS / Frontend
# -------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# -------------------------------------------------------------------
# Local stateless API auth
# (used to sign your local access tokens)
# -------------------------------------------------------------------
LOCAL_JWT_SECRET=change-this-to-something-random

# -------------------------------------------------------------------
# Tool Support / LTI bootstrap
# (used when validating launch tokens)
# -------------------------------------------------------------------
TOOLSUPPORT_JWKS_URL=https://canvas.instructure.com/api/lti/security/jwks
TOOLSUPPORT_JWT_ISS=https://canvas.instructure.com
TOOLSUPPORT_JWT_AUD=
TOOLSUPPORT_SKIP_SIGNATURE=false

# -------------------------------------------------------------------
# OpenAI
# -------------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_ME

# Optional tuning
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.3
