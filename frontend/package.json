{
  "name": "lti-ox6q-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:app && npm run build:runners && npm run build:runner-pages",
    "build:app": "vite build",
    "build:runners": "vite build --config vite.runner-open.config.js && vite build --config vite.runner-structured.config.js",
