    "@instructure/ui": "^11",
    "@instructure/ui-icons": "^11.5.0",
    "@instructure/ui-themes": "^11.5.0",
    "@oxctl/ui-lti": "^10.6.0",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
